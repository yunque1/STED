---
import Layout from '../layouts/Layout.astro';
import Wrapper from '../components/ui/Wrapper.astro';
import Text from '../components/ui/Text.astro';
---

<Layout title="Terms">
  <main class="pt-28 pb-24">
    <Wrapper>
      <div class="max-w-3xl mx-auto rounded-2xl border border-slate-700 bg-slate-800 p-8">
        <Text tag="h1" variant="displayXL" class="text-white text-4xl md:text-5xl mb-6">Terms & Conditions</Text>
        <div class="space-y-6 text-slate-300">
          <p>By using our website and services, you agree to the following terms. Please read them carefully.</p>
          <p>We provide electronics manufacturing and related services. All proposals, pricing and delivery timelines are subject to mutual confirmation and may vary based on materials availability and production capacity.</p>
          <p>All content, brand assets, and materials provided by customers for production must be properly licensed and compliant with local regulations.</p>
          <p>For any questions, reach out to our team through the Contact section.</p>
        </div>
      </div>
    </Wrapper>
  </main>
</Layout>

