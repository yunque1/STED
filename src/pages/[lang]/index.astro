---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import { languages, ui, defaultLang } from '../../i18n/translations';
import Timeline from '../../components/Timeline.astro';
import OrgStructure from '../../components/OrgStructure.astro';
import CompanyProfile from '../../components/CompanyProfile.astro';
import Features from '../../components/Features.astro';
import Stats from '../../components/Stats.astro';
import Pricing from '../../components/Pricing.astro';
import Showcase from '../../components/Showcase.astro';
import Testimonials from '../../components/Testimonials.astro';
import Contact from '../../components/Contact.astro';
import About from '../../components/About.astro';
import ProcurementOrg from '../../components/ProcurementOrg.astro';
import ProcurementModel from '../../components/ProcurementModel.astro';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter(lang => lang !== defaultLang)
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params;
const content = ui[lang as keyof typeof ui] || ui[defaultLang];
---

<Layout title={`${content.hero.companyName}`}>
	<Navbar lang={lang as keyof typeof languages} content={content.nav} />
	<main>
		<Hero content={content.hero} />
		
		<Features title={content.features.title} subtitle={content.features.subtitle} items={content.features.items} />

    <CompanyProfile title={content.company.introTitle} paragraphs={content.company.introParagraphs} />

    <Pricing title={content.pricing.title} subtitle={content.pricing.subtitle} tiers={content.pricing.tiers} />

    <Stats title={content.stats.title} items={content.stats.items} />

    <ProcurementOrg title={content.procurementOrg.title} description={content.procurementOrg.description} />

    <Timeline title={content.timeline.title} items={content.timeline.items} />

    <OrgStructure title={content.org.title} top={content.org.top} units={content.org.units} />

    <ProcurementModel title={content.procurementModel.title} segments={content.procurementModel.segments} note={content.procurementModel.note} />

    <Showcase title={content.gallery.title} subtitle={content.gallery.subtitle} labels={content.gallery.labels} />

    <Testimonials title={content.testimonials.title} items={content.testimonials.items} />

    <Contact title={content.contact.title} desc={content.contact.desc} groups={content.contact.groups} />

		<About 
      whyUsTitle={content.about.whyUsTitle} 
      items={content.about.items} 
      aboutTitle={content.about.aboutTitle} 
      aboutDesc1={content.about.aboutDesc1} 
      aboutDesc2={content.about.aboutDesc2} 
    />
	</main>
	<Footer content={content.footer} />
</Layout>
