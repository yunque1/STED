---
interface Props {
  content: {
    companyName: string;
    headline: string;
    subhead: string;
    ctaPrimary: string;
    ctaSecondary: string;
  };
}

const { content } = Astro.props;
import Text from './ui/Text.astro';
import Button from './ui/Button.astro';
import Wrapper from './ui/Wrapper.astro';
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full z-0 pointer-events-none">
    <img src="https://source.unsplash.com/2JJ3wBHu4_0/1600x900" alt="electronics manufacturing facility" class="absolute inset-0 w-full h-full object-cover opacity-25" onerror="this.onerror=null; this.style.display='none';" />
    <img src="/images/chip-grid.svg" alt="chip grid" class="absolute inset-0 w-full h-full object-cover opacity-20 mix-blend-screen" />
    <div class="absolute top-20 left-1/4 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-1/4 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-purple-500/10 to-pink-500/10 mix-blend-soft-light"></div>
    <div class="absolute -top-24 -left-24 w-[36rem] h-[36rem] rounded-full bg-gradient-to-tr from-pink-500/15 to-blue-500/15 blur-3xl"></div>
    <div class="absolute -bottom-24 -right-24 w-[36rem] h-[36rem] rounded-full bg-gradient-to-tr from-indigo-500/15 to-emerald-500/15 blur-3xl"></div>
  </div>

  <Wrapper class="relative z-10 text-center">
    <Text tag="h1" variant="displayXL" class="mb-8">
      <span class="block text-slate-100 mb-2">{content.companyName}</span>
      <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 drop-shadow-lg">
        {content.headline}
      </span>
    </Text>

    <Text tag="p" variant="textBase" class="mt-6 max-w-3xl mx-auto text-xl text-slate-300">
      {content.subhead}
    </Text>

    <div class="mt-10 flex justify-center gap-4">
      <Button isLink={true} href="#contact" variant="primary" size="medium" class="shadow-blue-500/25 hover:shadow-blue-500/40">
        {content.ctaPrimary}
      </Button>
      <Button isLink={true} href="#features" variant="secondary" size="medium" class="backdrop-blur">
        {content.ctaSecondary}
      </Button>
    </div>
  </Wrapper>
</section>
