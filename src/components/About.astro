---
interface Props {
  whyUsTitle: string;
  items: {
    title: string;
    desc: string;
  }[];
  aboutTitle: string;
  aboutDesc1: string;
  aboutDesc2: string;
}

const { whyUsTitle, items, aboutTitle, aboutDesc1, aboutDesc2 } = Astro.props;
---

<section id="about" class="py-24 relative overflow-hidden">
  <!-- Background Gradient -->
  <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-b from-slate-950 to-slate-900 -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">
      
      <!-- Left: Why Us -->
      <div class="mb-12 lg:mb-0">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-8 tracking-tight">{whyUsTitle}</h2>
        <div class="space-y-8">
          {items.map((item, index) => (
            <div class="flex group">
              <div class="flex-shrink-0">
                <div class={`flex items-center justify-center h-14 w-14 rounded-2xl text-white shadow-lg transition-transform group-hover:scale-110 ${index === 0 ? 'bg-gradient-to-br from-blue-500 to-blue-600 shadow-blue-500/20' : 'bg-gradient-to-br from-purple-500 to-purple-600 shadow-purple-500/20'}`}>
                  <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={index === 0 ? "M13 10V3L4 14h7v7l9-11h-7z" : "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"} />
                  </svg>
                </div>
              </div>
              <div class="ml-6">
                <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
                <p class="text-slate-400 leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: About Text Card -->
      <div class="relative">
        <div class="absolute -inset-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl blur-lg opacity-30 animate-pulse"></div>
        <div class="relative bg-slate-800 rounded-2xl border border-slate-700 p-8 md:p-10 overflow-hidden">
          <img src="/images/data-center.svg" alt="manufacturing background" class="absolute inset-0 w-full h-full object-cover opacity-10 mix-blend-overlay" />
          
          <h3 class="text-2xl font-bold text-white mb-6">{aboutTitle}</h3>
          <div class="space-y-4 text-slate-300 leading-relaxed">
            <p>{aboutDesc1}</p>
            <p>{aboutDesc2}</p>
          </div>

          <div class="mt-8 pt-8 border-t border-slate-700 flex items-center gap-4">
             <div class="flex -space-x-2">
               <div class="w-8 h-8 rounded-full bg-slate-600 border-2 border-slate-800"></div>
               <div class="w-8 h-8 rounded-full bg-slate-500 border-2 border-slate-800"></div>
               <div class="w-8 h-8 rounded-full bg-slate-400 border-2 border-slate-800"></div>
             </div>
             <div class="text-sm text-slate-400">Trusted by global partners</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
