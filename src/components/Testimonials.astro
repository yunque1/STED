---
interface Props {
  title: string;
  items: {
    quote: string;
    author: string;
    role: string;
  }[];
}

const { title, items } = Astro.props;
---

<section id="testimonials" class="py-24 relative overflow-hidden bg-slate-900/50">
  <!-- Background Decoration -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-slate-700 to-transparent"></div>
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-slate-700 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{title}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {items.map((t, i) => (
        <div class="relative p-8 rounded-2xl bg-slate-800 border border-slate-700 hover:border-blue-500/30 transition-colors">
          <!-- Quote Icon -->
          <div class="absolute top-6 left-6 text-slate-700">
            <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V11C14.017 11.5523 13.5693 12 13.017 12H12.017V5H22.017V15C22.017 18.3137 19.3307 21 16.017 21H14.017ZM5.0166 21L5.0166 18C5.0166 16.8954 5.91203 16 7.0166 16H10.0166C10.5689 16 11.0166 15.5523 11.0166 15V9C11.0166 8.44772 10.5689 8 10.0166 8H6.0166C5.46432 8 5.0166 8.44772 5.0166 9V11C5.0166 11.5523 4.56889 12 4.0166 12H3.0166V5H13.0166V15C13.0166 18.3137 10.3303 21 7.0166 21H5.0166Z" /></svg>
          </div>

          <div class="relative z-10">
            <p class="text-slate-300 text-lg italic mb-6 pt-6">"{t.quote}"</p>
            <div class="flex items-center">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm">
                {t.author.charAt(0)}
              </div>
              <div class="ml-4">
                <div class="text-white font-semibold">{t.author}</div>
                <div class="text-slate-500 text-sm">{t.role}</div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
