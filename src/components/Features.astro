---
interface Props {
  title: string;
  subtitle: string;
  items: {
    title: string;
    desc: string;
  }[];
}

const { title, subtitle, items } = Astro.props;

const icons = [
  // PCBA / Assembly
  `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
  // Computer / Device
  `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>`,
  // Global / Supply Chain
  `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
];

const colors = [
  'blue',
  'purple',
  'pink'
];
---

<section id="features" class="py-24 relative overflow-hidden">
  <!-- Background Blobs -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl -z-10"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{title}</h2>
      <p class="text-slate-400 max-w-2xl mx-auto text-lg">{subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {items.map((item, index) => (
        <div class="group relative p-8 rounded-2xl bg-slate-800/40 border border-slate-700/50 backdrop-blur-sm hover:bg-slate-800/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-blue-500/10">
          <!-- Gradient Border on Hover -->
          <div class={`absolute inset-0 rounded-2xl border-2 border-transparent group-hover:border-${colors[index % 3]}-500/30 transition-colors pointer-events-none`}></div>
          
          <div class={`w-16 h-16 rounded-xl flex items-center justify-center mb-6 transition-all duration-300 bg-${colors[index % 3]}-500/10 text-${colors[index % 3]}-400 group-hover:scale-110 group-hover:bg-${colors[index % 3]}-500/20`}>
            <Fragment set:html={icons[index % icons.length]} />
          </div>

          <h3 class="text-2xl font-bold text-white mb-4">{item.title}</h3>
          <p class="text-slate-400 leading-relaxed">
            {item.desc}
          </p>

          <div class={`mt-6 inline-flex items-center text-${colors[index % 3]}-400 font-medium opacity-0 group-hover:opacity-100 transition-opacity transform translate-y-2 group-hover:translate-y-0`}>
            Learn more 
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
