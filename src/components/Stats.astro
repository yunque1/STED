---
interface Props {
  title: string;
  items: {
    value: string;
    label: string;
  }[];
}

const { title, items } = Astro.props;
---

<section id="stats" class="py-24 relative bg-slate-900/30 border-y border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-2xl font-bold text-slate-200 uppercase tracking-widest">{title}</h2>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      {items.map((s, i) => (
        <div class="relative text-center group">
          <div class="text-4xl md:text-5xl font-extrabold bg-clip-text text-transparent bg-gradient-to-b from-white to-slate-500 mb-2 group-hover:to-blue-400 transition-all duration-500">
            {s.value}
          </div>
          <div class="h-1 w-12 mx-auto bg-blue-500/50 rounded-full mb-4 group-hover:w-24 transition-all duration-500"></div>
          <div class="text-slate-400 font-medium tracking-wide uppercase text-sm">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
