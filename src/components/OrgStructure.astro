---
interface Props {
  title: string;
  top: string[];
  units: string[];
}

const { title, top, units } = Astro.props;
---

<section id="org-structure" class="py-24 relative overflow-hidden">
  <!-- Background Decoration -->
  <div class="absolute inset-0 bg-slate-900/50 -z-20"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-7xl pointer-events-none overflow-hidden">
      <div class="absolute top-[10%] left-[10%] w-[500px] h-[500px] bg-blue-600/5 rounded-full blur-[100px]"></div>
      <div class="absolute bottom-[10%] right-[10%] w-[500px] h-[500px] bg-purple-600/5 rounded-full blur-[100px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{title}</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-blue-500 to-purple-600 mx-auto rounded-full"></div>
    </div>

    <div class="relative">
      <!-- Top Level (Board & GM) -->
      <div class="flex flex-col items-center justify-center gap-8 mb-12">
        {top.map((item, index) => (
          <div class="relative z-10">
             <!-- Connector Line for 2nd item -->
            {index > 0 && (
               <div class="absolute -top-8 left-1/2 -translate-x-1/2 w-0.5 h-8 bg-slate-600"></div>
            )}
            
            <div class="w-64 p-4 rounded-xl bg-gradient-to-b from-slate-800 to-slate-900 border border-slate-700 shadow-xl shadow-blue-900/10 text-center relative group hover:-translate-y-1 transition-transform duration-300">
              <div class="absolute inset-0 bg-gradient-to-r from-blue-500/10 to-purple-500/10 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <h3 class="text-xl font-bold text-white relative z-10">{item}</h3>
            </div>
          </div>
        ))}
      </div>

      <!-- Connector to Units -->
      <div class="relative h-12 mb-8 hidden md:block">
         <div class="absolute left-1/2 -translate-x-1/2 top-0 h-full w-0.5 bg-slate-600"></div>
         <!-- Horizontal bar -->
         <div class="absolute bottom-0 left-[10%] right-[10%] h-0.5 bg-slate-600"></div>
         <!-- Vertical ticks for units would be complex to align perfectly with grid, simplified approach below -->
      </div>

      <!-- Units Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative">
        {units.map((unit, index) => (
          <div class="relative group">
             <!-- Mobile connector -->
             <div class="md:hidden absolute -top-6 left-1/2 -translate-x-1/2 w-0.5 h-6 bg-slate-600"></div>
             
             <!-- Desktop Top Connector (Visual only) -->
             <div class="hidden md:block absolute -top-8 left-1/2 -translate-x-1/2 w-0.5 h-8 bg-slate-600"></div>

             <div class="h-full p-6 rounded-xl bg-slate-800/50 backdrop-blur-sm border border-slate-700 hover:border-blue-500/50 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/10 group-hover:-translate-y-1">
                <div class="flex flex-col items-center text-center">
                  <div class="w-12 h-12 rounded-lg bg-slate-700/50 flex items-center justify-center mb-4 text-blue-400 group-hover:text-blue-300 group-hover:scale-110 transition-all">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  </div>
                  <span class="text-slate-200 font-medium group-hover:text-white transition-colors">{unit}</span>
                </div>
             </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
