---
interface Props {
  title: string;
  items: {
    year: string;
    desc: string;
  }[];
}

const { title, items } = Astro.props;
---

<section id="timeline" class="py-24 relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-7xl pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{title}</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-blue-500 to-purple-600 mx-auto rounded-full"></div>
    </div>

    <div class="relative max-w-4xl mx-auto">
      <!-- Vertical Line -->
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-500/0 via-slate-700 to-blue-500/0 md:-translate-x-1/2"></div>

      <div class="space-y-12">
        {items.map((item, index) => (
          <div class={`relative flex items-start md:items-center md:justify-between ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''}`}>
            
            <!-- Dot -->
            <div class="absolute left-4 md:left-1/2 w-4 h-4 rounded-full bg-blue-500 border-4 border-slate-900 shadow-[0_0_10px_rgba(59,130,246,0.5)] transform -translate-x-1/2 md:translate-x-[-50%] mt-1.5 md:mt-0 z-10"></div>

            <!-- Content Spacer for Desktop -->
            <div class="hidden md:block w-5/12"></div>

            <!-- Card -->
            <div class="ml-12 md:ml-0 w-full md:w-5/12">
              <div class="group relative bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 p-6 rounded-2xl hover:bg-slate-800 transition-all duration-300 hover:border-blue-500/30 hover:shadow-lg hover:shadow-blue-500/10">
                <span class="inline-block px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 text-sm font-bold mb-3 border border-blue-500/20">
                  {item.year}
                </span>
                <p class="text-slate-300 text-lg leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
