---
interface Props {
  variant?: 'standard';
  class?: string;
}

const { variant = 'standard', class: className = '' } = Astro.props as Props;
const base =
  variant === 'standard'
    ? 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'
    : 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8';
---

<div class={`${base} ${className}`}>
  <slot />
</div>

