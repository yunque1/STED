---
interface Props {
  title: string;
  subtitle: string;
  tiers: {
    name: string;
    price: string;
    desc: string;
    features: string[];
    cta: string;
  }[];
}

const { title, subtitle, tiers } = Astro.props;
---

<section id="pricing" class="py-24 relative overflow-hidden bg-slate-900 border-t border-slate-800/50">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-blue-500/20 to-transparent"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">{title}</h2>
      <p class="text-slate-400 max-w-2xl mx-auto text-lg">{subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      {tiers.map((t, i) => (
        <div class={`relative rounded-3xl p-8 transition-all duration-300 ${
          i === 1 
            ? 'bg-slate-800/80 border-2 border-blue-500/50 shadow-2xl shadow-blue-500/20 scale-105 z-10' 
            : 'bg-slate-900/40 border border-slate-700/50 hover:bg-slate-800/60 hover:border-slate-600'
        }`}>
          {i === 1 && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-blue-600 to-purple-600 text-white px-4 py-1 rounded-full text-sm font-bold shadow-lg">
              Most Popular
            </div>
          )}

          <div class="mb-6">
            <h3 class="text-xl font-bold text-white mb-2">{t.name}</h3>
            <div class="text-3xl font-bold text-slate-200">{t.price}</div>
          </div>

          <p class="text-slate-400 mb-8 h-12">{t.desc}</p>

          <ul class="space-y-4 mb-8">
            {t.features.map((f) => (
              <li class="flex items-start text-slate-300">
                <svg class="w-5 h-5 text-green-400 mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 111.42-1.42l2.79 2.79 6.79-6.79a1 1 0 011.42 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-sm">{f}</span>
              </li>
            ))}
          </ul>

          <a href="#contact" class={`block w-full py-4 rounded-xl text-center font-bold transition-all duration-200 ${
            i === 1
              ? 'bg-blue-600 hover:bg-blue-700 text-white shadow-lg shadow-blue-500/25'
              : 'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 hover:border-slate-600'
          }`}>
            {t.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
